# ======================================================
# GoalCompass Platform  Environment Variables
# ======================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# For local dev: all MOCK_ flags default to true so the
# app runs end-to-end without live credentials.
# ======================================================

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Database (PostgreSQL + TimescaleDB) ──────────────
DATABASE_URL=postgres://ff_user:ff_pass@localhost:5432/goalcompass
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=goalcompass
DATABASE_USER=ff_user
DATABASE_PASSWORD=ff_pass

# ── Redis (BullMQ + Caching) ─────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_32_CHARS_MIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d
NEXTAUTH_SECRET=CHANGE_THIS_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth (optional) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Feature Flags ────────────────────────────────────
# Set to true to enable Track B research terminal
FEATURE_TRACK_B_ENABLED=false
FEATURE_TRACK_B_SCREENER=false
FEATURE_TRACK_B_VALUATION=false
FEATURE_TRACK_B_PORTFOLIO=false
FEATURE_TRACK_B_SPECIAL_SITUATIONS=false
NEXT_PUBLIC_FEATURE_TRACK_B_ENABLED=false

# ── Mock Adapters (set false in production to use real integrations) ──
USE_MOCK_MF_EXECUTION=true
USE_MOCK_KYC=true
USE_MOCK_PAYMENTS=true
USE_MOCK_MESSAGING=true
USE_MOCK_VIDEO=true
USE_MOCK_MARKET_DATA=true

# ── Payments: Razorpay ──────────────────────────────
# docs/integrations/razorpay.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── MF Execution: BSE StAR MF ────────────────────────
# docs/integrations/bse-star-mf.md
BSE_STAR_MF_BASE_URL=https://bsestarmf.in/
BSE_STAR_MF_USER=
BSE_STAR_MF_PASSWORD=
BSE_STAR_MF_MEMBER_CODE=
BSE_STAR_MF_PASSKEY=

# ── KYC: KRA (CVL / CAMS / KFin) ────────────────────
# docs/integrations/kyc-kra.md
KYC_KRA_PROVIDER=cvl            # cvl | cams | kfin | ndml
KYC_KRA_API_KEY=
KYC_KRA_BASE_URL=https://www.cvlkra.com/

# ── Messaging: WhatsApp BSP ──────────────────────────
# docs/integrations/whatsapp-bsp.md
WHATSAPP_BSP_PROVIDER=gupshup   # gupshup | interakt | aisensy
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_APP_NAME=
WHATSAPP_FROM_NUMBER=

# ── Messaging: Email (Amazon SES) ────────────────────
# docs/integrations/ses.md
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=GoalCompass


# ── Video Hosting: Cloudflare Stream ─────────────────
# docs/integrations/video-hosting.md
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
NEXT_PUBLIC_CF_STREAM_CUSTOMER_SUBDOMAIN=

# ── Market Data (Track B) ─────────────────────────────
# docs/integrations/truedata.md
TRUEDATA_API_KEY=
TRUEDATA_API_SECRET=
TRUEDATA_BASE_URL=https://history.truedata.in

# ── S3 / Object Storage ───────────────────────────────
S3_ENDPOINT=
S3_BUCKET=goalcompass-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# ── AMFI NAV (public, no key needed) ─────────────────
AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
