{
  "name": "goalcompass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter types build && pnpm --filter calc build && pnpm --filter validators build && pnpm --filter api build && pnpm --filter web build",
    "test": "pnpm -r test",
    "test:calc": "pnpm --filter @ff/calc test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter api migration:run",
    "db:seed": "pnpm --filter api seed",
    "docker:up": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.override.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": "20.x",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "overrides": {
    "next": ">=14.2.35",
    "postcss": ">=8.5.18",
    "js-yaml": ">=4.3.1",
    "multer": ">=1.4.5-lts.1",
    "lodash": ">=4.17.21",
    "minimatch": ">=9.0.5",
    "picomatch": ">=4.0.2",
    "tmp": ">=0.2.6"
  }
}
